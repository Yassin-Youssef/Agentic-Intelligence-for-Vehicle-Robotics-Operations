# Phase 4 — API Keys
# Copy this file to .env and fill in your keys.

# Anthropic — used by Search Agent (Sonnet) and Explanation Agent (Opus)
ANTHROPIC_API_KEY=

# OpenAI — used by Formatting Agent (GPT) and Coding Agent (GPT-4o-mini)
OPENAI_API_KEY=

# OpenRouter — alternative unified endpoint (optional)
OPENROUTER_API_KEY=

# GitHub — used by MCP config for CI status, issues, PRs
GITHUB_TOKEN=
